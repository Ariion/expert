# =============================================================================
# StatusPulse — variables d'environnement
#
# NE REMPLISSEZ PAS CE FICHIER À LA MAIN.
# Lancez « npm run setup » : il vous demande les 4 valeurs qu'il ne peut pas
# deviner, génère ou récupère toutes les autres, et écrit .env.local pour vous.
# Ce fichier n'est qu'une référence documentaire.
# =============================================================================

# --- À FOURNIR (les 4 seules valeurs qu'on vous demandera) -------------------

# Supabase > Project Settings > Database > Connection string > "Transaction
# pooler" (port 6543). Le pooler est indispensable en serverless.
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# URL publique canonique, sans slash final. Sert aux liens email, aux
# redirections Stripe, au sitemap et aux URL canoniques.
APP_URL="https://statuspulse.app"

# Stripe > Développeurs > Clés API
STRIPE_SECRET_KEY="sk_live_xxx"

# Resend > API Keys, et expéditeur sur un domaine vérifié chez Resend
# (sans domaine vérifié, les alertes partent en spam).
RESEND_API_KEY="re_xxx"
EMAIL_FROM="StatusPulse <alertes@statuspulse.app>"

# --- REMPLI AUTOMATIQUEMENT PAR « npm run setup » ---------------------------

# Créés dans Stripe par le script (produits, tarifs, endpoint webhook).
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_PRO="price_xxx"
STRIPE_PRICE_TEAM="price_xxx"

# Passez à "true" seulement après avoir activé Stripe Tax et déclaré une
# inscription fiscale : sinon le paiement échouerait.
STRIPE_AUTOMATIC_TAX="false"

# Générés aléatoirement (48 et 24 octets). AUTH_SECRET hache les sessions et
# signe les webhooks sortants ; CRON_SECRET protège /api/cron/*.
AUTH_SECRET="généré automatiquement"
CRON_SECRET="généré automatiquement"

# --- ALERTING SYSTÈME (optionnel techniquement, essentiel en pratique) ------
# Seul canal par lequel le produit vous réclame de l'attention : panne du
# collecteur, file d'alertes bloquée, webhook Stripe en échec. Sans lui, une
# panne peut durer des jours sans que personne ne le sache.
OPS_ALERT_EMAIL="vous@votredomaine.com"
OPS_ALERT_WEBHOOK="https://hooks.slack.com/services/xxx/yyy/zzz"

# --- DÉPLOIEMENT AUTOMATIQUE (optionnel) ------------------------------------
# Renseignez-les pour que « npm run setup » pousse lui-même toutes les
# variables ci-dessus dans Vercel, sans copier-coller.
VERCEL_TOKEN=""       # Vercel > Account Settings > Tokens
VERCEL_PROJECT_ID=""  # Project Settings > General > Project ID
VERCEL_TEAM_ID=""     # uniquement si le projet appartient à une équipe
