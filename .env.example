# =============================================================================
# StatusPulse — variables d'environnement
# Copier en .env.local pour le développement, et renseigner les mêmes valeurs
# dans Vercel (Project Settings > Environment Variables) pour la production.
# =============================================================================

# --- Base de données ---------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > "Transaction pooler"
# (port 6543). Le pooler est indispensable en serverless.
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# --- Application -------------------------------------------------------------
# URL publique canonique, sans slash final. Sert aux liens email, aux
# redirections Stripe, au sitemap et aux URL canoniques.
APP_URL="https://statuspulse.app"

# --- Stripe ------------------------------------------------------------------
# Dashboard Stripe > Développeurs > Clés API
STRIPE_SECRET_KEY="sk_live_xxx"
# Dashboard Stripe > Développeurs > Webhooks > votre endpoint > Signing secret
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# ID des prix récurrents créés dans Stripe (Catalogue de produits)
STRIPE_PRICE_PRO="price_xxx"
STRIPE_PRICE_TEAM="price_xxx"

# --- Email transactionnel (Resend) -------------------------------------------
RESEND_API_KEY="re_xxx"
# Doit utiliser un domaine vérifié dans Resend, sinon les emails partent en spam.
EMAIL_FROM="StatusPulse <alertes@statuspulse.app>"

# --- Secrets -----------------------------------------------------------------
# 32+ caractères aléatoires. Génération : openssl rand -base64 48
AUTH_SECRET="remplacer_par_une_valeur_aleatoire_de_48_caracteres_minimum"
# Protège les routes /api/cron/*. Vercel l'envoie automatiquement en Authorization.
CRON_SECRET="remplacer_par_une_valeur_aleatoire"

# --- Alerting système (optionnel mais fortement recommandé) ------------------
# Destinataires des alertes critiques : panne d'ingestion, file bloquée,
# webhook Stripe en échec. C'est ce qui vous permet de ne jamais regarder
# le produit tant qu'il fonctionne.
OPS_ALERT_EMAIL="vous@votredomaine.com"
OPS_ALERT_WEBHOOK="https://hooks.slack.com/services/xxx/yyy/zzz"
