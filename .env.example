# =============================================================================
# Upstream Status — variables d'environnement
#
# NE REMPLISSEZ PAS CE FICHIER À LA MAIN.
#
# À l'import d'un projet, Vercel pré-remplit son écran « Environment Variables »
# à partir de ce modèle : RETIREZ-LES TOUTES avec le bouton « − » et déployez.
# Elles sont posées ensuite, avec leurs vraies valeurs, par le workflow
# « 1. Installation ».
# Lancez « npm run setup » : il vous demande les 4 valeurs qu'il ne peut pas
# deviner, génère ou récupère toutes les autres, et écrit .env.local pour vous.
# Ce fichier n'est qu'une référence documentaire.
# =============================================================================

# --- À FOURNIR (les 4 seules valeurs qu'on vous demandera) -------------------

# Supabase > Project Settings > Database > Connection string > "Transaction
# pooler" (port 6543). Le pooler est indispensable en serverless.
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# URL publique canonique, sans slash final. Sert aux liens email, aux
# redirections Stripe, au sitemap et aux URL canoniques.
APP_URL="https://upstreamstatus.com"

# Stripe > Développeurs > Clés API
STRIPE_SECRET_KEY="sk_live_xxx"

# Resend > API Keys, et expéditeur sur un domaine vérifié chez Resend
# (sans domaine vérifié, les alertes partent en spam).
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Upstream Status <alertes@upstreamstatus.com>"

# --- REMPLI AUTOMATIQUEMENT PAR « npm run setup » ---------------------------

# Créés dans Stripe par le script (produits, tarifs, endpoint webhook).
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_PRO="price_xxx"
STRIPE_PRICE_TEAM="price_xxx"

# Passez à "true" seulement après avoir activé Stripe Tax et déclaré une
# inscription fiscale : sinon le paiement échouerait.
STRIPE_AUTOMATIC_TAX="false"

# Générés aléatoirement (48 et 24 octets). AUTH_SECRET hache les sessions et
# signe les webhooks sortants ; CRON_SECRET protège /api/cron/*.
AUTH_SECRET="généré automatiquement"
CRON_SECRET="généré automatiquement"

# --- ALERTING SYSTÈME (optionnel techniquement, essentiel en pratique) ------
# Seul canal par lequel le produit vous réclame de l'attention : panne du
# collecteur, file d'alertes bloquée, webhook Stripe en échec. Sans lui, une
# panne peut durer des jours sans que personne ne le sache.
OPS_ALERT_EMAIL="vous@votredomaine.com"
OPS_ALERT_WEBHOOK="https://hooks.slack.com/services/xxx/yyy/zzz"

# --- DÉPLOIEMENT AUTOMATIQUE -------------------------------------------------
# Le token Vercel qui permet à l'installation de pousser ces variables et de
# redéployer le site n'est VOLONTAIREMENT pas listé ici : Vercel interdit le
# préfixe réservé « VERCEL_ » et refuserait l'import du projet.
#
# Il se déclare ailleurs, jamais sur cet écran :
#   - parcours navigateur : secret GitHub « VERCEL_TOKEN »
#     (Settings > Secrets and variables > Actions) ;
#   - parcours terminal   : une ligne portant ce même nom, ajoutée à .env.local
#     (ce fichier-ci n'est qu'un modèle ; seul .env.local est lu localement).
# L'identifiant du projet et l'URL publique sont retrouvés automatiquement.

# ---------------------------------------------------------------------------
# Mentions légales — identité de l'éditeur
# ---------------------------------------------------------------------------
# Obligatoire en France dès qu'un site vend quelque chose. Le bloc n'est affiché
# que si LEGAL_PUBLISHER et LEGAL_REGISTRATION sont tous deux renseignés :
# mieux vaut aucune mention qu'une mention inventée.
#
# C'est le SEUL endroit du produit où une identité apparaît. Le nom commercial
# affiché partout ailleurs reste « Upstream Status » : la marque sous laquelle on
# vend n'a pas à être celle sous laquelle on est immatriculé.
LEGAL_PUBLISHER="Prénom Nom"
LEGAL_REGISTRATION="SIREN 000 000 000"
LEGAL_CONTACT_EMAIL="contact@upstreamstatus.com"
LEGAL_ADDRESS="Ville, France"

# ---------------------------------------------------------------------------
# Panneau /admin — statistiques de visites (optionnel)
# ---------------------------------------------------------------------------
# Tant que cette valeur est absente, /admin répond « non configuré » et refuse
# toute connexion : le reste du site continue de fonctionner normalement.
# Choisissez un mot de passe long (16+ caractères) — c'est la seule protection
# de ce panneau, ajoutez-la ensuite à .env.local et relancez « npm run setup »
# pour qu'il soit poussé sur Vercel.
ADMIN_PASSWORD="choisissez-un-mot-de-passe-long"
